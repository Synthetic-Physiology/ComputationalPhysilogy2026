        <button id="tab-btn-2" onclick="switchTab(2)" class="flex-1 lg:flex-initial px-3 py-1.5 text-xs font-semibold rounded-md transition-all text-slate-400 hover:text-slate-200">Graph 2: Einzelparameter</button>
        <button id="tab-btn-3" onclick="switchTab(3)" class="flex-1 lg:flex-initial px-3 py-1.5 text-xs font-semibold rounded-md transition-all text-slate-400 hover:text-slate-200">Knotenvergleich (Bar)</button>
